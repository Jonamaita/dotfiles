(defcfg
  ;; For Linux
  input  (device-file "/dev/input/by-id/usb-Drop_Inc._ALT_v2-event-kbd")
  output (uinput-sink "kmonad output")
  fallthrough true
  cmp-seq ralt    ;; Set the compose key to `RightAlt'
  cmp-seq-delay 5 ;; 5ms delay between each compose-key sequence press
  ;; Set this to false to disable any command-execution in KMonad
  allow-cmd true
  ;; Set the implicit around to `around`
  implicit-around around
)


(defsrc
  grv  1    2    3    4    5    6    7    8    9    0    -    =    bspc
  tab  q    w    e    r    t    y    u    i    o    p    [    ]    \
  caps a    s    d    f    g    h    j    k    l    ;    '    ret
  lsft z    x    c    v    b    n    m    ,    .    /    rsft
  lctl lmet lalt           spc            ralt rmet cmp  rctl
)

;;default layer aliases

(defalias
  spc (tap-next-release spc (layer-toggle navigation))
)

(deflayer mylayer
  grv  1    2    3    4    5    6    7    8    9    0    -    =    bspc
  tab  q    w    e    r    t    y    u    i    o    p    [    ]    \
  esc  a    s    d    f    g    h    j    k    l    ;    '    ret
  lsft z    x    c    v    b    n    m    ,    .    /    rsft
  lctl lmet lalt           @spc            ralt rmet cmp  rctl
)


(deflayer navigation
  _  _    _    _    _    _    _      _    _    _    _    _    _    _
  _  _    _    _    _    _    del    home ins  end  _    _    _    _
  _  _    _    _    _    _    lft    down up   rght _    _    _
  _  _    _    _    _    _    _      _    _    _    _    _
  _  _    _              _           _    _    _    _
)


